{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/out/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "20",
        "FGB_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "windows-ninja-debug",
      "displayName": "Windows x64 Ninja Debug",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "FGB_WARNINGS_AS_ERRORS": "ON"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows-ninja-release",
      "displayName": "Windows x64 Ninja RelWithDebInfo",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows-vs2022",
      "displayName": "Windows x64 Visual Studio 2022（本机日常/CI 同构）",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "cacheVariables": {
        "FGB_WARNINGS_AS_ERRORS": "ON"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows-vs2019",
      "displayName": "Windows x64 Visual Studio 2019",
      "inherits": "base",
      "generator": "Visual Studio 16 2019",
      "architecture": "x64",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows-vs2019-release",
      "displayName": "Windows x64 VS2019 Release（出 dist/ 发布包）",
      "inherits": "base",
      "generator": "Visual Studio 16 2019",
      "architecture": "x64",
      "installDir": "${sourceDir}/dist",
      "cacheVariables": {
        "FGB_BUILD_TESTS": "OFF"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    }
  ],
  "buildPresets": [
    { "name": "windows-ninja-debug", "configurePreset": "windows-ninja-debug" },
    { "name": "windows-ninja-release", "configurePreset": "windows-ninja-release" },
    { "name": "windows-vs2022", "configurePreset": "windows-vs2022", "configuration": "Debug" },
    { "name": "windows-vs2019", "configurePreset": "windows-vs2019", "configuration": "Debug" },
    {
      "name": "windows-vs2019-release",
      "configurePreset": "windows-vs2019-release",
      "configuration": "Release",
      "jobs": 8
    }
  ],
  "testPresets": [
    {
      "name": "windows-ninja-debug",
      "configurePreset": "windows-ninja-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-ninja-release",
      "configurePreset": "windows-ninja-release",
      "output": { "outputOnFailure": true }
    }
  ]
}
