// 版本信息与图标。由 CMake configure_file 生成（版本号跟着 project() 走）。
// 图标行由 CMake 传进来：只有产品入口带图标，命令行引擎留空（见 src/CMakeLists.txt）。
#include <windows.h>

@FGB_RC_ICON_LINE@

1 VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Aqamoe"
            VALUE "FileDescription", "@FGB_RC_DESCRIPTION@"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "@FGB_RC_INTERNAL_NAME@"
            VALUE "OriginalFilename", "@FGB_RC_FILENAME@"
            VALUE "ProductName", "FaceGaze Bridge"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
            VALUE "LegalCopyright", "Copyright (C) 2026 Aqamoe. Licensed under Apache-2.0."
            VALUE "Comments", "https://github.com/Aqamoe/FaceGaze-Bridge"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
